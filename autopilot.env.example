# Copy and configure locally; no credentials or broker are supplied.
AUTOPILOT_VESSEL_ID=vessel
AUTOPILOT_CALIBRATION_FILE=calibration.json
# Optional bootstrap route. The example is invented, not a navigable route.
# AUTOPILOT_ROUTE_FILE=route.json
# MQTT requires your TLS WebSocket broker, matching topic permissions and secrets.
# AUTOPILOT_MQTT_HOST=broker.example.org
# AUTOPILOT_MQTT_PORT=443
# AUTOPILOT_MQTT_USERNAME=your-account
# AUTOPILOT_MQTT_PASSWORD_FILE=/path/to/private-password
# Optional unauthenticated HTTP on all interfaces: isolated test network only.
# AUTOPILOT_DIRECT_HTTP_PORT=8765
# NMEA input defaults to UDP 10110; empty disables it.
# AUTOPILOT_NMEA_UDP_PORT=10110
# Disable status broadcasts until the intended network is configured.
AUTOPILOT_STATUS_UDP_PORT=
# AUTOPILOT_STATUS_UDP_BROADCAST=255.255.255.255
# Optional existing motor-web manual proxy; automatic steering stays blocked
# without calibration. External motor-web software is not bundled here.
# AUTOPILOT_MANUAL_PROXY_URL=http://127.0.0.1:8080
